{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soundmine.com/studio/v1/connections.schema.json",
  "title": "Soundmine physical connections v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "devices",
    "connections"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "studio.connections"
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profileId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profileId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "signal",
          "confirmation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "$ref": "#/$defs/endpoint"
          },
          "to": {
            "$ref": "#/$defs/endpoint"
          },
          "signal": {
            "enum": [
              "midi",
              "usb-midi",
              "pitch-cv",
              "gate",
              "velocity-cv",
              "clock",
              "audio"
            ]
          },
          "confirmation": {
            "enum": [
              "confirmed",
              "declared",
              "unverified"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "portId"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "portId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
