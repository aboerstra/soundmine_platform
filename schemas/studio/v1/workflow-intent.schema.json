{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soundmine.com/studio/v1/workflow-intent.schema.json",
  "title": "Soundmine workflow intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "roles",
    "goals",
    "constraints"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "workflow.intent"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserveDirectCvGate": {
          "type": "boolean"
        },
        "preserveHardwareVelocityCv": {
          "type": "boolean"
        },
        "allowAdditionalHardware": {
          "type": "boolean"
        },
        "requirePerNoteHarmonicAdaptation": {
          "type": "boolean"
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "eventGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "routes"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventRoute"
          }
        }
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "capabilityId",
        "priority",
        "minimumEvidence"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "minimumEvidence": {
          "enum": [
            "verified",
            "manufacturer-documented",
            "user-declared",
            "unverified"
          ]
        }
      }
    },
    "event": {
      "enum": [
        "notes",
        "harmony",
        "clock",
        "control"
      ]
    },
    "eventInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event"
      ],
      "properties": {
        "event": {
          "$ref": "#/$defs/event"
        },
        "merge": {
          "enum": [
            "priority",
            "combine"
          ]
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/eventInput"
          }
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "eventEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "portId"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "portId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "eventRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/eventEndpoint"
        },
        "to": {
          "$ref": "#/$defs/eventEndpoint"
        }
      }
    }
  }
}
