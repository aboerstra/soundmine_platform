{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soundmine.com/studio/v1/execution-plan.schema.json",
  "title": "Soundmine execution plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "intentId",
    "status",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "workflow.execution-plan"
    },
    "intentId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "feasible",
        "conditional",
        "infeasible"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
