  "kind": "workflow.intent",
  "id": "adaptive-analog-bass",
  "name": "Adaptive Analog Bass",
  "roles": {
    "harmonySource": "sl61",
    "patternSource": "bsp",
    "soundGenerator": "marvin"
  },
  "goals": [
